Q_CENTRAL_HOSTNAME=q-central.zt.q-home.local
Q_CENTRAL_EXTERNAL_URL=https://q-central.zt.q-home.local
Q_CENTRAL_DB_PATH=/data/qcentral.db
Q_CENTRAL_SECRET_KEY=change-me-use-openssl-rand-hex-32
# Entra setup, role assignments and deployment: ../docs/ENTRA.md
Q_CENTRAL_AUTH_MODE=entra
Q_CENTRAL_ENTRA_TENANT_ID=
Q_CENTRAL_ENTRA_CLIENT_ID=
Q_CENTRAL_ENTRA_CLIENT_SECRET=
Q_CENTRAL_ENTRA_SESSION_MINUTES=15
# Cohvera-style login: SG-PORTAL-Admins -> Portal.Admin on the Q-Central app.
# No group IDs or redirect URI variable are needed for that approach.
# Optional alternative: comma-separated group Object IDs in the ID token.
Q_CENTRAL_ENTRA_ADMIN_GROUP_IDS=
Q_CENTRAL_ENTRA_SUPERADMIN_GROUP_IDS=
Q_CENTRAL_PORTAL_TOKEN_HASH=replace-with-bcrypt-hash-from-scripts-create-portal-token
Q_CENTRAL_CORS_ORIGINS=https://q-central.zt.q-home.local
Q_CENTRAL_ZEROTIER_NETWORK_ID=8056c2e21c000001
Q_CENTRAL_ZEROTIER_API_TOKEN=replace-with-controller-token
Q_CENTRAL_AUTO_AUTHORIZE=true
Q_CENTRAL_LOG_LEVEL=INFO
